                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offsetDays\": \"<integer>\",\n  \"jobs\": {\n    \"filter\": \"<string>\",\n    \"copyAllocations\": true\n  },\n  \"shifts\": {\n    \"filter\": \"<string>\",\n    \"copyAllocations\": true\n  },\n  \"activities\": {\n    \"filter\": \"<string>\",\n    \"copyAllocations\": true\n  }\n}",
