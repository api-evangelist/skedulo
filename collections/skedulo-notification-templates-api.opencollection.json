{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authentication Admin Notification Templates API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Notification Templates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Notification template default values",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.skedulo.com/auth/v2/templates/defaults",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Fetch the default values for notification templates."
        },
        {
          "info": {
            "name": "Get all notification templates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.skedulo.com/auth/v2/templates",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get all notification templates"
        },
        {
          "info": {
            "name": "Create or update a notification template for a protocol",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.skedulo.com/auth/v2/template/:type/:protocol",
            "params": [
              {
                "name": "type",
                "value": "",
                "type": "path"
              },
              {
                "name": "protocol",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create or update a notification template for a protocol"
        },
        {
          "info": {
            "name": "Delete notification template",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.skedulo.com/auth/v2/template/:type/:protocol",
            "params": [
              {
                "name": "type",
                "value": "",
                "type": "path"
              },
              {
                "name": "protocol",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete the notification template associated with a message protocol. Any future messages sent through this protocol will use the default template."
        }
      ]
    }
  ],
  "bundled": true
}