                "method": "PUT",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"recurringScheduleId\": \"<string>\",\n  \"from\": \"2017-05-17T03:30:00Z\",\n  \"jobFields\": {\n    \"Description\": \"new description\",\n    \"JobTasks\": [\n      {\n        \"Seq\": 1,\n        \"Name\": \"Task 1\",\n        \"Completed\": false\n      },\n      {\n        \"Seq\": 2,\n        \"Name\": \"Task 2\",\n        \"Completed\": false\n      }\n    ]\n  },\n  \"start\": \"<time>\",\n  \"excludeJobIds\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"duration\": 15\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
