        {
          "id": "b3494c56-f0e3-4caa-8e8d-40945d287b9b",
          "name": "Update jobs in a recurring schedule",
          "request": {
            "name": "Update jobs in a recurring schedule",
            "description": {
              "content": "Updates the fields and attached objects of jobs in a recurring schedule, where the jobs start at or after the provided timestamp. Arrays of attached 'HasMany' objects can be provided along with the fields to be updated. In this case, all existing attached objects of the same type on future jobs will be deleted and replaced with the provided objects. Job IDs may be explicitly excluded - this allows the caller to prevent modifying the job that they are currently displaying. Jobs that are Locked, In Progress, Completed or Cancelled will not be updated.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "schedules",
                "jobs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recurringScheduleId\": \"<string>\",\n  \"from\": \"<dateTime>\",\n  \"jobFields\": {\n    \"key_0\": \"string\"\n  },\n  \"start\": \"<time>\",\n  \"excludeJobIds\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"duration\": \"<number>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "68a0a9e4-f6a1-4741-8104-a4699b73b86b",
              "name": "jobs successfully updated",
              "originalRequest": {
