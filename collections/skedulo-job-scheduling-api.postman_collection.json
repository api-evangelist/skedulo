          "name": "Create recurring schedule from an existing job",
          "request": {
            "name": "Create recurring schedule from an existing job",
            "description": {
              "content": "Fields and Child relationships can be specified (e.g., giving created jobs the same job tags or allocations). By default, required Job fields like Region ID and duration will be propagated even if not specified.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "schedules",
                "jobs",
                "existing"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jobId\": \"<string>\",\n  \"pattern\": {\n    \"type\": \"<string>\",\n    \"step\": \"<number>\",\n    \"ackAllJobs\": \"<boolean>\",\n    \"endOn\": \"<date>\",\n    \"endAfterNumberOccurrences\": \"<number>\",\n    \"repeatMode\": \"<string>\",\n    \"skipOnWeekDays\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"repeatOnWeekDays\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"skipHolidays\": false,\n    \"excludeDates\": [\n      \"<date>\",\n      \"<date>\"\n    ],\n    \"includeDates\": [\n      \"<date>\",\n      \"<date>\"\n    ]\n  },\n  \"fieldsToPropagate\": {\n    \"fields\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"children\": [\n      {\n        \"value\": \"<Circular reference to #/components/schemas/FieldSpec detected>\"\n      },\n      {\n        \"value\": \"<Circular reference to #/components/schemas/FieldSpec detected>\"\n      }\n    ]\n  },\n  \"recurFrom\": \"<dateTime>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
