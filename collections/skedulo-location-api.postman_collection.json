          "name": "Locate resources with a set distance",
          "request": {
            "name": "Locate resources with a set distance",
            "description": {
              "content": "Locate all resources within a set distance of a specified location.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "location",
                "resources_within_distance"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "lat",
                  "value": "<double>",
                  "description": "(Required) The latitude (degrees).  This should be in decimal format, ie. \"DDD.DDDD\" not degrees and minutes.\n"
                },
                {
                  "disabled": false,
                  "key": "lng",
                  "value": "<double>",
                  "description": "(Required) The longitude of the position (degrees).  This should be in decimal format, ie. \"DDD.DDDD\" not degrees and minutes.\n"
                },
                {
                  "disabled": false,
                  "key": "distance",
                  "value": "<double>",
                  "description": "(Required) The distance (metres) to query for resources.  Note that the accuracy of the resources location is not considered when making this query."
