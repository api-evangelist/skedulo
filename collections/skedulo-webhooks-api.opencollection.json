{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authentication Admin Webhooks API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get webhooks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.skedulo.com/auth/webhooks",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get all existing webhooks"
        },
        {
          "info": {
            "name": "Create a new webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.skedulo.com/auth/webhooks",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Establish a new webhook."
        },
        {
          "info": {
            "name": "Delete a webhook",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.skedulo.com/auth/webhooks/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Identifier of the webhook to delete."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a webhook using the webhook ID."
        },
        {
          "info": {
            "name": "Webhook GraphQL schema",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.skedulo.com/auth/webhooks/schema",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve the GraphQL schema that is used for webhooks with type `graphql`."
        },
        {
          "info": {
            "name": "Webhook GraphQL introspection",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.skedulo.com/auth/webhooks/graphql",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Perform an introspection query against the GraphQL query that is used for webhooks with type `graphql`."
        },
        {
          "info": {
            "name": "Webhook Deferred GraphQL schema",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.skedulo.com/auth/webhooks/deferred/schema",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve the GraphQL schema that is used for webhooks with type `graphql_deferred`."
        },
        {
          "info": {
            "name": "Webhook Deferred GraphQL introspection",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.skedulo.com/auth/webhooks/deferred/graphql",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Perform an introspection query against the GraphQL query that is used for webhooks with type `graphql_deferred`."
        }
      ]
    }
  ],
  "bundled": true
}