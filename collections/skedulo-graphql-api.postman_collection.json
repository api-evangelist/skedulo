        {
          "id": "ddd4d914-693f-4077-9475-20533d4ea5b6",
          "name": "Make batch queries and mutations using GraphQL.",
          "request": {
            "name": "Make batch queries and mutations using GraphQL.",
            "description": {
              "content": "GraphQL batching involves sending multiple queries or mutations to the server in a single request. This reduces the number of server round trips to fetch data, which makes interaction more efficient. \n\nSee https://blog.apollographql.com/query-batching-in-apollo-63acfd859862 for more information",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "graphql",
                "batch"
