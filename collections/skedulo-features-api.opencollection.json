{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authentication Admin Features API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Features",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Feature flag status, description, and type",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.skedulo.com/auth/features/descriptions",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves the status of feature flags along with their descriptions and type."
        },
        {
          "info": {
            "name": "Tenant Feature flag statuses",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.skedulo.com/auth/features/:tenant_id",
            "params": [
              {
                "name": "tenant_id",
                "value": "",
                "type": "path",
                "description": "ID of the tenant"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves the status of feature flags for the provided tenant"
        },
        {
          "info": {
            "name": "Feature flag status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.skedulo.com/auth/features/descriptions/:tenant_id",
            "params": [
              {
                "name": "tenant_id",
                "value": "",
                "type": "path",
                "description": "ID of the tenant"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves the status of feature flags along with their descriptions and type of the provided tenant."
        },
        {
          "info": {
            "name": "Feature flag status for multiple tenants",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.skedulo.com/auth/features/tenants/search",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves the status of feature flags for all the provided Tenant ID's."
        },
        {
          "info": {
            "name": "Feature flag status and descriptions for multiple tenants",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.skedulo.com/auth/features/descriptions/tenants/search",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves the status of feature flags along with their descriptions and type for all the provided Tenant ID's."
        }
      ]
    }
  ],
  "bundled": true
}