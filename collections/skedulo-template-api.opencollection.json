{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authentication Admin Template API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Template",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create template",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.skedulo.com/auth/template",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a new template."
        },
        {
          "info": {
            "name": "Update template",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.skedulo.com/auth/template/:template_id",
            "params": [
              {
                "name": "template_id",
                "value": "",
                "type": "path",
                "description": "Identifier of the template to update."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update an existing template."
        },
        {
          "info": {
            "name": "Delete template",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.skedulo.com/auth/template/:template_id",
            "params": [
              {
                "name": "template_id",
                "value": "",
                "type": "path",
                "description": "Identifier of the template to delete."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a template."
        },
        {
          "info": {
            "name": "Template values",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.skedulo.com/auth/template/:template_id/values",
            "params": [
              {
                "name": "template_id",
                "value": "",
                "type": "path",
                "description": "Identifier of the template to retrieve values for."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Return template values for a template."
        },
        {
          "info": {
            "name": "Update template values",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.skedulo.com/auth/template/:template_id/values",
            "params": [
              {
                "name": "template_id",
                "value": "",
                "type": "path",
                "description": "Identifier of the template to add values for."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "All existing values will removed and the values provided will be inserted."
        }
      ]
    }
  ],
  "bundled": true
}