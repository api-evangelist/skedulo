{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authentication Admin Device Notification Information and Registration API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Device Notification Information and Registration",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Register a device ID",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.skedulo.com/auth/device_id",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Register a device ID."
        },
        {
          "info": {
            "name": "Delete device ID",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.skedulo.com/auth/device_id",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete device ID."
        }
      ]
    }
  ],
  "bundled": true
}