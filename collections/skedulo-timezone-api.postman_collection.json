          "name": "Return timezone information for a location",
          "request": {
            "name": "Return timezone information for a location",
            "description": {
              "content": "Given a location and timestamp return the timezone name, the offset and Daylight Savings offset.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "timezone"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "location",
                  "value": "<number>,<number>",
                  "description": "(Required) Latitude and Longitude of the location to find the timezone for"
                },
                {
                  "disabled": false,
                  "key": "timestamp",
                  "value": "<integer>",
                  "description": "(Required) Seconds since 1970 for the timezone to return (used to compute DST offset)"
                }
              ],
              "variable": []
            },
            "header": [
