      "item": [
        {
          "id": "645874c9-b28b-4fd2-8fc5-7052d63511af",
          "name": "Retrieve historical routes for one or more resources.",
          "request": {
            "name": "Retrieve historical routes for one or more resources.",
            "description": {
              "content": "Given a comma-separated list of resource Ids and a start and end date, return the route taken by that resource between the start and end time.\n\nThe maximum amount of time supported is 24 hours.\n\nThe supported formats are\n* _polyline_ Uses the Google Maps Polyline encoding (default)\n* _wkt_ - Well Known Text Strings.  Either a LINESTRING or a POINT is returned\n* _geojson_ - GeoJSON format. Either a linestring or a point is returned\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "travel",
                "routes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "resource_ids",
                  "value": "<string>",
                  "description": "(Required) Comma separated resource Id values"
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<dateTime>",
                  "description": "(Required) Start time"
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<dateTime>",
                  "description": "(Required) End Time"
                },
                {
                  "disabled": false,
                  "key": "accuracy",
                  "value": "<double>",
                  "description": "All points returned will have an accuracy of at least the number given. If this parameter is not provided the default value is 100. To return all points use an empty string."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "<string>",
                  "description": "Output Format."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "5077820a-1ecc-4806-a9d7-4c4844090990",
