{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authentication Admin Geocode API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Geocode",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Geocode an address",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.skedulo.com/auth/geocode",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "For a given list of addreseses, returns a list of geocoded `LatLng`, or errors."
        }
      ]
    }
  ],
  "bundled": true
}