{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authentication Admin Link Resource API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Link Resource",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create link between resource and user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.skedulo.com/auth/link_resource",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Links (assigns) a resource to a user by their respective Ids."
        },
        {
          "info": {
            "name": "Remove link between resource and user",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.skedulo.com/auth/link_resource",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Unlinked a resource to a user by their respective Ids."
        }
      ]
    }
  ],
  "bundled": true
}