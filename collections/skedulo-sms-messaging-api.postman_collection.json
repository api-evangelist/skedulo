          "name": "Send an SMS to any phone number",
          "request": {
            "name": "Send an SMS to any phone number",
            "description": {
              "content": "Send an SMS message to any phone number, such as a customer.\n\nFor example 'Thanks for confirming your booking'. Replies from the recipient will not be tracked back to a job but can be used to trigger an 'inbound_sms' webhook.",
              "type": "text/plain"
            },
            "url": {
