{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authentication Admin Metadata API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Metadata",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get metadata for the authenticated user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.skedulo.com/auth/metadata/user",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves metadata including user details, team information, and associated resource data for the currently authenticated user."
        }
      ]
    }
  ],
  "bundled": true
}