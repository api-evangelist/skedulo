{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authentication Admin Rules API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Rules",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Resolve record access rules",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.skedulo.com/auth/rules/resolve",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Resolves the supplied rule definitions into valid EQL filters, combining rules by object type and returning errors for any invalid filter definitions. Requires the Record Access Policies feature to be enabled."
        },
        {
          "info": {
            "name": "Record access rules for the current user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.skedulo.com/auth/rules/user",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the current user's record access rules."
        }
      ]
    }
  ],
  "bundled": true
}